public class Sorted{
     // Checks whether the array is sorted 
    public static boolean srt (int[]array) {
          // Compare each element with the next element
        for(int i=0;i<array.length - 1; i++){
               // If the current element is greater than the next,
            if(array[i]>array[i+1]){
                return false;
            }
        }
           // If elements are in correce order, return true
        return true;
        
    }
    public static void main (String[] args) {
        int[] array1={2,4,5,6,7,1,3};
        int[] array2={1,2,3,4,5,6,7};
        System.out.println(srt(array1));
        System.out.println(srt(array2));
    }
}
